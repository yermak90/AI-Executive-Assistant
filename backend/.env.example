DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/ai_executive_assistant
APP_TIMEZONE=Asia/Almaty

# Used only by the test suite (tests/conftest.py). Created automatically by
# docker-compose (see scripts/init-test-db.sql); if you run PostgreSQL
# without Docker, create it once with: createdb ai_executive_assistant_test
TEST_DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/ai_executive_assistant_test

# Sprint 2 — Voice Note AI Capture. "fake" providers are deterministic and
# make no network calls; this is what CI and local dev without credentials
# run by default. Real adapter values are placeholders only — never commit
# a real key here.
STT_PROVIDER=fake
STT_BASE_URL=
STT_API_KEY=
STT_MODEL=
LLM_PROVIDER=fake
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
VOICE_CAPTURE_MAX_SECONDS=90
VOICE_CAPTURE_MAX_BYTES=15728640
VOICE_CAPTURE_TTL_HOURS=24
AI_REQUEST_TIMEOUT_SECONDS=30
AI_MAX_RETRIES=1
